# .claudeignore
# Excludes files from Claude Code's context to save tokens
# Uses .gitignore syntax (glob patterns)

# Dependencies
node_modules/

# Build outputs
.next/
dist/
build/
out/
*.tsbuildinfo

# Test coverage reports
coverage/
.nyc_output/

# Local Supabase files
.supabase/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# Environment files (local only)
.env.local
.env.*.local

# IDE/Editor files (except .vscode/settings.json which may have project config)
.vscode/*
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db

# Temporary files
*.tmp
*.temp
.cache/

# Lock files (uncomment if you rarely need to debug dependencies)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Test files (uncomment if you're not actively working on tests)
# *.test.ts
# *.test.tsx
# *.spec.ts
# *.spec.tsx

# Historical documentation (uncomment if you rarely reference it)
# history/

# Large data/media files that don't need AI analysis
# *.png
# *.jpg
# *.jpeg
# *.gif
# *.mp4
# *.pdf

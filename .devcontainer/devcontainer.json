{
  "name": "Financial Planner App Dev Container",
  "image": "mcr.microsoft.com/devcontainers/typescript-node:dev-24-bookworm",

  "features": {
    // Personal feature: Claude Code with the shared claude-code-config volume at
    // /var/lib/claude-code, plus git identity and SSH commit signing through the
    // forwarded agent (defaults are the personal identity and signing key).
    // Needs `docker login ghcr.io` on the host (private package).
    "ghcr.io/etiennedelange/devcontainer-features/dev-setup:1": {},
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:3.0.1": {}
  },

  "customizations": {
    "vscode": {
      "extensions": [
        // Oxc (through Vite+) lints and formats; its extension is the editor's formatter.
        "oxc.oxc-vscode",
        "bradlc.vscode-tailwindcss",
        "supabase.supabase-vscode",
        "ms-vscode.vscode-typescript-next",
        "formulahendry.auto-rename-tag",
        "christian-kohler.path-intellisense",
        "TypeScriptTeam.native-preview",
        "ms-playwright.playwright",
        "github.vscode-github-actions"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "oxc.oxc-vscode",
        "editor.codeActionsOnSave": {
          "source.fixAll.oxc": "explicit"
        },
        "typescript.tsdk": "node_modules/typescript/lib",
        "typescript.enablePromptUseWorkspaceTsdk": true,
        "[javascript][typescript][typescriptreact][json][jsonc][css]": {
          "editor.defaultFormatter": "oxc.oxc-vscode"
        }
      }
    }
  },

  "forwardPorts": [3000, 54321, 54323],

  "portsAttributes": {
    "3000": {
      "label": "Next.js App",
      "onAutoForward": "notify"
    },
    "54321": {
      "label": "Supabase API",
      "onAutoForward": "silent"
    },
    "54323": {
      "label": "Supabase Studio",
      "onAutoForward": "notify"
    }
  },

  "runArgs": ["--ipc=host", "--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],

  "containerEnv": {
    "GITHUB_COPILOT_API_KEY": "${localEnv:GITHUB_COPILOT_API_KEY}",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    // Long-lived token from `claude setup-token` (1 year), set as a host env
    // var or GitHub Codespaces secret. Lets Claude authenticate in a brand
    // new/ephemeral container without an interactive browser login — the
    // shared claude-code-config volume only carries auth across containers on
    // the same machine, not across fresh Codespaces or throwaway sandboxes.
    // Resolves to "" (falsy, ignored) when unset, so interactive /login
    // still works normally.
    "CLAUDE_CODE_OAUTH_TOKEN": "${localEnv:CLAUDE_CODE_OAUTH_TOKEN}"
    // "ANTHROPIC_BASE_URL": "http://host.docker.internal:11434/v1",
    // "ANTHROPIC_BASE_URL": "http://host.docker.internal:12434",
    // "ANTHROPIC_AUTH_TOKEN": "docker"
  },

  // sudo is required: postCreateCommand runs as remoteUser (node, non-root),
  // but a freshly created named volume starts out root-owned, so a plain
  // chown fails and the && chain would abort before post-create.sh ever runs.
  "postCreateCommand": "sudo chown -R node:node /home/node/.local /home/node/.config 2>/dev/null; bash .devcontainer/post-create.sh",

  "remoteUser": "node",

  "mounts": [
    "source=opencode-home-${devcontainerId},target=/home/node/.opencode,type=volume",
    "source=opencode-config-${devcontainerId},target=/home/node/.config/opencode,type=volume",
    "source=opencode-data-${devcontainerId},target=/home/node/.local/share/opencode,type=volume"
  ]
}

# Copy this file to .env.local and fill in the values.
# .env.local is gitignored — never commit real credentials.
#
# The post-create script copies this file to .env.local automatically
# on container rebuild if .env.local does not already exist.

# ── Local Supabase (npx supabase start) ──────────────────────────────────────
# These values are deterministic for every local Supabase instance.
# Run `npx supabase status` to verify. Local Supabase uses a JWT anon key —
# NOT the sb_publishable_ format (that's Supabase Cloud only).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# ── Production Supabase ───────────────────────────────────────────────────────
# Replace with values from your Supabase project dashboard → Settings → API.
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ── Feature flags ────────────────────────────────────────────────────────────
# Account sign-in (Supabase Auth) is WIP. Unset/anything but "true" = the
# sign-in dialog still opens but is fully disabled. Leave unset on Vercel until
# auth ships; NEXT_PUBLIC_* is inlined at build time, so flipping it needs a
# redeploy.
NEXT_PUBLIC_AUTH_ENABLED=true

# ── Vercel AI Gateway (AI plan narrative feature) ────────────────────────────
# Get a key from https://vercel.com/<team>/~/ai-gateway/api-keys — only needed
# for local development; Vercel deployments authenticate via OIDC instead.
AI_GATEWAY_API_KEY=

# ── Service role (server-only, never exposed to the browser) ──────────────────
# Required for account recovery and (later) account deletion. Local value comes
# from `npx supabase status`.
SUPABASE_SERVICE_ROLE_KEY=

# ── Cloudflare Turnstile (bot protection on auth forms) ──────────────────────
# Local dev: test keys that always pass — https://developers.cloudflare.com/turnstile/troubleshooting/testing/
# Local Supabase validates captcha tokens against TURNSTILE_SECRET_KEY (see
# supabase/config.toml [auth.captcha]), so the local site key + secret must
# remain a matching test pair. Do NOT put real keys here for local dev.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Production: real Cloudflare widget (the site key is public — it ships in the
# client bundle). Configure in two places, both outside this repo:
#   1. Hosting platform env, set BEFORE `next build` (NEXT_PUBLIC_* is inlined
#      at build time):
#        NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAENVcI5snagBAJ2G
#        TURNSTILE_SECRET_KEY=<widget secret — Cloudflare dashboard → Turnstile → your widget → Settings>
#   2. Hosted Supabase dashboard → Authentication → Bot and Abuse Prevention →
#      CAPTCHA → provider "Turnstile" → paste the same secret key
#      (supabase/config.toml only applies to local Supabase).
# The widget's hostname allowlist (Cloudflare dashboard) must include the
# production domain or the widget will not render there.
# instrumentation.ts (AUTH-007) crashes the production server at startup if
# either var is missing or the site key is still a published test key.

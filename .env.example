# No environment variables are required.
#
# The app has no accounts, no database and no server-held secrets: plan data is kept
# in the browser's localStorage, and the optional AI summary calls the user's chosen
# provider directly from the browser with a key the user supplies in Settings.
#
# Optional: NEXT_PUBLIC_SITE_URL — canonical site URL for metadata / OG images
# (see lib/utils/site-url.ts).

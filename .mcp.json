{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--browser", "chromium", "--headless"],
      "env": {}
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@latest", "mcp"]
    },
    "filesystem": {
      "command": "sh",
      "args": ["-c", "npx -y @modelcontextprotocol/server-filesystem \"$CLAUDE_PROJECT_DIR\""]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch", "--with", "mcp<2.0.0"]
    },
    "github": {
      "type": "http",
      "url": "https://api.githubcopilot.com/mcp/",
      "headers": {
        "Authorization": "Bearer ${GITHUB_COPILOT_API_KEY}"
      }
    }
  }
}

{
  "name": "sa-retirement-calculator",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.1.2",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "analyze": "ANALYZE=true pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "ui:doc": "playwright test",
    "ui:doc:desktop": "playwright test --project=desktop-chrome",
    "ui:doc:tablet": "playwright test --project=tablet",
    "ui:doc:mobile": "playwright test --project=mobile",
    "ui:doc:headed": "playwright test --headed",
    "ui:doc:debug": "playwright test --debug",
    "ui:doc:report": "playwright show-report",
    "perf:baseline": "node perf/measure.mjs --label baseline --scenario empty --out perf/baseline.json",
    "perf:baseline:interactive": "node perf/measure.mjs --label baseline-interactive --scenario interactive --out perf/baseline-interactive.json",
    "perf:baseline:interaction": "node perf/measure.mjs --label baseline-interaction --scenario interaction --out perf/baseline-interaction.json",
    "perf:after": "node perf/measure.mjs --label after --scenario empty --out perf/after.json",
    "perf:after:interactive": "node perf/measure.mjs --label after-interactive --scenario interactive --out perf/after-interactive.json",
    "perf:after:interaction": "node perf/measure.mjs --label after-interaction --scenario interaction --out perf/after-interaction.json",
    "perf:compare": "node perf/compare.mjs perf/baseline.json perf/after.json",
    "perf:compare:interactive": "node perf/compare.mjs perf/baseline-interactive.json perf/after-interactive.json",
    "perf:compare:interaction": "node perf/compare.mjs perf/baseline-interaction.json perf/after-interaction.json"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.105.4",
    "@vercel/analytics": "^2.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.16.0",
    "motion": "^12.38.0",
    "next": "16.2.3",
    "next-themes": "^0.4.6",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.75.0",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.13"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@next/bundle-analyzer": "^16.2.6",
    "@playwright/test": "^1.60.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@types/node": "^20.19.41",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitest/coverage-v8": "^4.1.6",
    "@vitest/ui": "^4.1.6",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "16.2.3",
    "happy-dom": "^20.9.0",
    "postcss": "^8.5.14",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}

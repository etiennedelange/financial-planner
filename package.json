{
  "name": "financial-planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "preinstall": "npx -y only-allow pnpm",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "vp lint",
    "check": "vp check",
    "typecheck": "tsc --noEmit",
    "shadscan": "shadscan --no-roast",
    "shadscan:json": "shadscan --json",
    "shadscan:gate": "shadscan --no-roast --fail-under 90",
    "docs:check": "node scripts/docs-check.mjs",
    "analyze": "ANALYZE=true pnpm build",
    "test": "vp test run",
    "test:watch": "vp test",
    "test:ui": "vp test --ui",
    "test:coverage": "vp test run --coverage",
    "test:rls": "docker exec -i $(docker ps --filter name=supabase_db --format '{{.Names}}' | head -1) psql -U postgres -d postgres -v ON_ERROR_STOP=1 < supabase/tests/rls_mfa.test.sql",
    "ui:doc": "playwright test",
    "ui:doc:desktop": "playwright test --project=desktop-chrome",
    "ui:doc:tablet": "playwright test --project=tablet",
    "ui:doc:mobile": "playwright test --project=mobile",
    "ui:doc:headed": "playwright test --headed",
    "ui:doc:debug": "playwright test --debug",
    "ui:doc:report": "playwright show-report",
    "perf:baseline": "node perf/measure.mjs --label baseline --scenario empty --out perf/baseline.json",
    "perf:baseline:interactive": "node perf/measure.mjs --label baseline-interactive --scenario interactive --out perf/baseline-interactive.json",
    "perf:baseline:interaction": "node perf/measure.mjs --label baseline-interaction --scenario interaction --out perf/baseline-interaction.json",
    "perf:after": "node perf/measure.mjs --label after --scenario empty --out perf/after.json",
    "perf:after:interactive": "node perf/measure.mjs --label after-interactive --scenario interactive --out perf/after-interactive.json",
    "perf:after:interaction": "node perf/measure.mjs --label after-interaction --scenario interaction --out perf/after-interaction.json",
    "perf:compare": "node perf/compare.mjs perf/baseline.json perf/after.json",
    "perf:compare:interactive": "node perf/compare.mjs perf/baseline-interactive.json perf/after-interactive.json",
    "perf:compare:interaction": "node perf/compare.mjs perf/baseline-interaction.json perf/after-interaction.json",
    "knip": "knip"
  },
  "dependencies": {
    "@animateicons/react": "^0.12.1",
    "@hookform/resolvers": "^5.9.1",
    "@radix-ui/react-accordion": "^1.3.1",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ai": "^7.0.152",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.61.0",
    "motion": "^14.6.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "xstate": "^5.33.3",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "16.4.3",
    "@playwright/test": "^1.64.1",
    "@shadscan/cli": "0.17.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "catalog:",
    "@vitest/ui": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.43.0",
    "otplib": "^13.5.0",
    "postcss": "^8.5.31",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.152.0"
  },
  "packageManager": "pnpm@12.6.0"
}
